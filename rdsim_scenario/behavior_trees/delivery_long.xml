<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="3"
      main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <Sequence>
      <SetBlackboard value="000"
                     output_key="error_code"/>
      <NavigateToPose goal="{start_goal}"
                      behavior_tree=""/>
      <Fallback>
        <SubTree ID="PutProductTree"
                 __shared_blackboard="true"/>
        <SetBlackboard value="001"
                       output_key="error_code"/>
        <ForceFailure>
          <NavigateToPose goal="{initial_goal}"
                          behavior_tree=""/>
        </ForceFailure>
      </Fallback>
      <NavigateToPose goal="{end_goal}"
                      behavior_tree=""/>
      <RecoveryNode number_of_retries="5">
        <Sequence>
          <AlwaysSuccess/>
        </Sequence>
        <Sequence>
          <SetBlackboard value="002"
                         output_key="error_code"/>
          <ForceFailure>
            <SubTree ID="ReturnProductTree"
                     __shared_blackboard="true"/>
          </ForceFailure>
        </Sequence>
      </RecoveryNode>
      <Fallback>
        <SubTree ID="TakeoutProductTree"
                 __shared_blackboard="true"/>
        <SetBlackboard value="003"
                       output_key="error_code"/>
        <ForceFailure>
          <SubTree ID="ReturnProductTree"
                   __shared_blackboard="true"/>
        </ForceFailure>
      </Fallback>
      <NavigateToPose goal="{initial_goal}"
                      behavior_tree=""/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PutProductTree">
    <ReactiveFallback>
      <IsProductPlaced topic_name="product_placed"/>
      <Timeout msec="30000">
        <Wait wait_duration="30"/>
      </Timeout>
    </ReactiveFallback>
  </BehaviorTree>

  <BehaviorTree ID="ReturnProductTree">
    <Sequence>
      <NavigateToPose goal="{start_goal}"
                      behavior_tree=""/>
      <SubTree ID="TakeoutProductTree"
               __shared_blackboard="true"/>
      <NavigateToPose goal="{initial_goal}"
                      behavior_tree=""/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="TakeoutProductTree">
    <ReactiveFallback>
      <Inverter>
        <IsProductPlaced topic_name="product_placed"/>
      </Inverter>
      <Timeout msec="30000">
        <Wait wait_duration="30"/>
      </Timeout>
    </ReactiveFallback>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Condition ID="IsProductPlaced">
      <input_port name="topic_name">Topic for subscribe</input_port>
    </Condition>
    <Action ID="NavigateToPose">
      <input_port name="goal">Goal</input_port>
      <input_port name="behavior_tree">Behavior tree to run</input_port>
    </Action>
    <Control ID="RecoveryNode">
      <input_port name="number_of_retries">Number of retries</input_port>
    </Control>
    <Action ID="Wait">
      <input_port name="wait_duration">Wait time</input_port>
    </Action>
  </TreeNodesModel>

</root>
